# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id

# Upstream LLM provider (OpenAI-compatible)
UPSTREAM_URL=https://api.z.ai/api/paas/v4
UPSTREAM_API_KEY=your-upstream-key
# Path prefix for upstream endpoints. Defaults to "/v1".
# Set to "" if the base URL already includes the version (e.g. zai's /v4).
UPSTREAM_PREFIX=

# Server
PORT=3000
# Public URL for the proxy (used in /config command output)
# Set this to your external HTTPS URL in production, e.g. https://api.ussyco.de
PUBLIC_URL=http://localhost:3000
# Optional Discord channel id for admin review requests.
# If unset, requests are posted in the same channel where the user ran /request-key.
ADMIN_REVIEW_CHANNEL_ID=
# Optional Discord channel id for media failure alerts.
# If unset, Routussy will look for a text channel literally named "routussy" in configured guilds.
MEDIA_ALERT_CHANNEL_ID=
# Optional alias for the Routussy text channel id.
ROUTUSSY_CHANNEL_ID=
# Optional comma-separated guild ids for instant slash command updates during development/admin use.
# Global commands can take time to propagate; guild commands appear almost immediately.
DISCORD_GUILD_IDS=

# Optional ussycode-specific display/config values for Discord commands.
# Example:
# USSYCODE_GATEWAY_HOST=ussycode.shuv.dev
# USSYCODE_GATEWAY_PORT=2224
# USSYCODE_VM_BASE_DOMAIN=ussycode.shuv.dev
USSYCODE_GATEWAY_HOST=
USSYCODE_GATEWAY_PORT=
USSYCODE_VM_BASE_DOMAIN=

# Database
DATABASE_PATH=routussy.db

# Optional: GitHub token for models.dev pricing fetches (avoids rate limits)
GITHUB_TOKEN=
